index 9ffcf52..6fef592 100644
--- a/backend/internal/session_manager/chat_spawn_test.go
+++ b/backend/internal/session_manager/chat_spawn_test.go
@@ -2085,3 +2085,27 @@ func TestChatSpawnDefaultRespectsProviderModes(t *testing.T) {
 		})
 	}
 }
+
+// Preparing room members must not enqueue work or widen native permissions.
+func TestPeerMemberEmptyChatSpawnDoesNotSendTask(t *testing.T) {
+	launcher := &recordingLauncher{}
+	m, _, _ := newChatManager(launcher)
+	for i := 0; i < 2; i++ {
+		_, _, _, err := m.Spawn(context.Background(), ports.SpawnConfig{
+			ProjectID: chatTestProject, Kind: domain.KindWorker, Harness: domain.HarnessCodex,
+			RequestedMode: domain.SessionModeChat,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if len(launcher.started) != 2 {
+		t.Fatalf("controllers = %d", len(launcher.started))
+	}
+	if len(launcher.turns) != 0 || len(launcher.queued) != 0 || len(launcher.relayed) != 0 {
+		t.Fatal("empty member spawn submitted work")
+	}
+	if launcher.started[0].SessionID == launcher.started[1].SessionID {
+		t.Fatal("members reused a session")
+	}
+}
diff --git a/frontend/src/renderer/components/PeerMemberPicker.test.tsx b/frontend/src/renderer/components/PeerMemberPicker.test.tsx
new file mode 100644
index 0000000..542afc8
--- /dev/null
+++ b/frontend/src/renderer/components/PeerMemberPicker.test.tsx
@@ -0,0 +1,110 @@
+import {
+	render,
+	screen,
+	fireEvent,
+	waitFor,
+	cleanup,
+} from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { beforeEach, afterEach, it, expect, vi } from "vitest";
+import { PeerMemberPicker } from "./PeerMemberPicker";
+const api = vi.hoisted(() => ({ GET: vi.fn(), POST: vi.fn() }));
+vi.mock("../lib/api-client", () => ({ apiClient: api }));
+afterEach(cleanup);
+beforeEach(() => {
+	vi.resetAllMocks();
+	api.GET.mockResolvedValue({
+		data: {
+			agents: ["codex", "deepseek-harness", "agy"].map((id) => ({
+				id,
+				installation: { state: id === "agy" ? "not_installed" : "installed" },
+				effectiveReadiness: "ready",
+			})),
+		},
+	});
+});
+function mount(selectedCount = 0) {
+	const added = vi.fn().mockResolvedValue(undefined);
+	render(
+		<QueryClientProvider
+			client={
+				new QueryClient({ defaultOptions: { queries: { retry: false } } })
+			}
+		>
+			<PeerMemberPicker
+				projectId="p"
+				selectedCount={selectedCount}
+				onAdded={added}
+				onClose={vi.fn()}
+				onBusyChange={vi.fn()}
+			/>
+		</QueryClientProvider>,
+	);
+	return added;
+}
+it("adds two Codex and a DeepSeek as independent empty chat sessions without sending work", async () => {
+	let n = 0;
+	api.POST.mockImplementation(async () => ({
+		data: { session: { id: `s${++n}` } },
+	}));
+	const added = mount();
+	await waitFor(() =>
+		expect(screen.getByLabelText("Codex 人数")).toBeEnabled(),
+	);
+	expect(api.POST).not.toHaveBeenCalled();
+	fireEvent.change(screen.getByLabelText("Codex 人数"), {
+		target: { value: "2" },
+	});
+	fireEvent.change(screen.getByLabelText("DeepSeek 人数"), {
+		target: { value: "1" },
+	});
+	fireEvent.click(screen.getByRole("button", { name: "添加 3 位成员" }));
+	await waitFor(() => expect(added).toHaveBeenCalledWith(["s1", "s2", "s3"]));
+	expect(api.POST.mock.calls.map((c) => c[1].body.harness)).toEqual([
+		"codex",
+		"codex",
+		"deepseek-harness",
+	]);
+	const keys = new Set();
+	for (const [path, options] of api.POST.mock.calls) {
+		expect(path).toBe("/api/v1/sessions");
+		expect(options.body).toMatchObject({
+			projectId: "p",
+			kind: "worker",
+			mode: "chat",
+			prompt: "",
+		});
+		expect(options.body.approvalMode).toBeUndefined();
+		keys.add(options.body.clientRequestId);
+	}
+	expect(keys.size).toBe(3);
+	expect(screen.getByRole("button", { name: "添加 3 位成员" })).toBeDisabled();
+});
+it("preserves partial success and does not replay an uncertain creation", async () => {
+	api.POST.mockResolvedValueOnce({
+		data: { session: { id: "s1" } },
+	}).mockRejectedValueOnce(new Error("connection lost"));
+	const added = mount();
+	await waitFor(() =>
+		expect(screen.getByLabelText("Codex 人数")).toBeEnabled(),
+	);
+	fireEvent.change(screen.getByLabelText("Codex 人数"), {
+		target: { value: "3" },
+	});
+	fireEvent.click(screen.getByRole("button", { name: "添加 3 位成员" }));
+	await waitFor(() => expect(added).toHaveBeenCalledWith(["s1"]));
+	expect(api.POST).toHaveBeenCalledTimes(2);
+	expect(screen.getByRole("button", { name: "添加 3 位成员" })).toBeDisabled();
+});
+it("blocks missing clients and exceeding room capacity", async () => {
+	mount(15);
+	await waitFor(() =>
+		expect(screen.getByLabelText("Codex 人数")).toBeEnabled(),
+	);
+	expect(screen.getByLabelText("Antigravity（Agy） 人数")).toBeDisabled();
+	fireEvent.change(screen.getByLabelText("Codex 人数"), {
+		target: { value: "2" },
+	});
+	expect(screen.getByRole("button", { name: "添加 2 位成员" })).toBeDisabled();
+	expect(api.POST).not.toHaveBeenCalled();
+});
diff --git a/frontend/src/renderer/components/PeerMemberPicker.tsx b/frontend/src/renderer/components/PeerMemberPicker.tsx
new file mode 100644
index 0000000..85e3aac
--- /dev/null
+++ b/frontend/src/renderer/components/PeerMemberPicker.tsx
@@ -0,0 +1,173 @@
+import { useState } from "react";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { apiClient } from "../lib/api-client";
+import { Button } from "./ui/button";
+
+const choices = [
+	{ id: "codex", label: "Codex" },
+	{ id: "deepseek-harness", label: "DeepSeek" },
+	{ id: "agy", label: "Antigravity（Agy）" },
+] as const;
+
+/** Create independent native chat sessions without an initial task or permission override. */
+export function PeerMemberPicker({
+	projectId,
+	selectedCount,
+	onAdded,
+	onClose,
+	onBusyChange,
+}: {
+	projectId: string;
+	selectedCount: number;
+	onAdded: (ids: string[]) => Promise<string>;
+	onClose: () => void;
+	onBusyChange: (busy: boolean) => void;
+}) {
+	const cache = useQueryClient();
+	const [counts, setCounts] = useState<Record<string, number>>({});
+	const [busy, setBusy] = useState(false);
+	const [attempted, setAttempted] = useState(false);
+	const [notice, setNotice] = useState("");
+	const readiness = useQuery({
+		queryKey: ["peer-member-readiness"],
+		retry: false,
+		queryFn: async () => {
+			const r = await apiClient.GET("/api/v1/agents/readiness");
+			if (r.error || !r.data) throw new Error("无法读取客户端状态");
+			return r.data.agents;
+		},
+	});
+	const total = Object.values(counts).reduce((sum, n) => sum + n, 0);
+	async function add() {
+		if (busy || attempted || !total || total + selectedCount > 16) return;
+		setBusy(true);
+		onBusyChange(true);
+		setAttempted(true);
+		const ids: string[] = [];
+		let failure = "";
+		let resultNotice = "";
+		try {
+			for (const choice of choices) {
+				for (let i = 0; i < (counts[choice.id] ?? 0); i++) {
+					setNotice(`正在准备 ${choice.label} ${i + 1}…`);
+					const r = await apiClient.POST("/api/v1/sessions", {
+						body: {
+							projectId,
+							kind: "worker",
+							mode: "chat",
+							harness: choice.id,
+							clientRequestId: crypto.randomUUID(),
+							prompt: "",
+						},
+					});
+					if (r.error || !r.data?.session.id) {
+						throw new Error(
+							`${choice.label} 创建未确认。请在成员列表或会话看板核查；不会自动重试。`,
+						);
+					}
+					ids.push(r.data.session.id);
+				}
+			}
+		} catch (e) {
+			failure = `${e instanceof Error ? e.message : "创建未确认"} 已停止后续创建；请核查会话看板，不会自动重试。`;
+		}
+		// Preserve successful sessions on partial failure. Never recreate them or send a task.
+		try {
+			await cache.invalidateQueries({ queryKey: ["workspaces"] });
+			if (ids.length) resultNotice = await onAdded(ids);
+		} catch {
+			failure += " 已创建的会话仍保留，请在成员列表选择并保存。";
+		} finally {
+			setNotice(failure || resultNotice);
+			setBusy(false);
+			onBusyChange(false);
+		}
+	}
+	return (
+		<section
+			aria-label="添加成员"
+			className="border-b border-border bg-secondary/30 p-4"
+		>
+			<div className="flex items-center justify-between gap-3">
+				<h2 className="font-medium">添加成员</h2>
+				<Button variant="quiet" disabled={busy} onClick={onClose}>
+					关闭
+				</Button>
+			</div>
+			<p className="my-2 text-sm text-muted-foreground">
+				选择每种智能体的人数，同一种也可以添加多位。只建立独立会话，不发送任务；客户端会启动并检查登录，权限沿用项目设置。
+			</p>
+			{readiness.isError && (
+				<p role="alert">无法读取客户端状态，请关闭后重试。</p>
+			)}
+			<div className="grid gap-3 sm:grid-cols-3">
+				{choices.map((choice) => {
+					const state = readiness.data?.find((a) => a.id === choice.id);
+					const missing = state?.installation.state === "not_installed";
+					return (
+						<label
+							key={choice.id}
+							className="flex flex-col gap-2 rounded border border-border p-3"
+						>
+							<span>{choice.label}</span>
+							<span className="text-xs text-muted-foreground">
+								{missing
+									? "未找到本机命令，暂不可添加"
+									: state?.effectiveReadiness === "ready"
+										? "客户端已就绪"
+										: "登录与连接仍需创建时验证"}
+							</span>
+							<input
+								aria-label={`${choice.label} 人数`}
+								type="number"
+								min={0}
+								max={16 - selectedCount}
+								value={counts[choice.id] ?? 0}
+								disabled={
+									busy ||
+									attempted ||
+									missing ||
+									readiness.isPending ||
+									readiness.isError
+								}
+								className="w-20 rounded border border-border bg-background p-2"
+								onChange={(e) =>
+									setCounts((old) => ({
+										...old,
+										[choice.id]: Math.max(
+											0,
+											Math.min(16, Math.floor(Number(e.target.value) || 0)),
+										),
+									}))
+								}
+							/>
+						</label>
+					);
+				})}
+			</div>
+			<div className="mt-3 flex flex-wrap items-center gap-3">
+				<Button
+					disabled={
+						busy ||
+						attempted ||
+						!total ||
+						selectedCount + total > 16 ||
+						readiness.isPending ||
+						readiness.isError
+					}
+					onClick={add}
+				>
+					{busy ? "正在准备成员…" : `添加 ${total} 位成员`}
+				</Button>
+				<span className="text-sm text-muted-foreground">
+					当前选择 {selectedCount} 位 · 房间最多 16 位
+				</span>
+			</div>
+			{notice && (
+				<p role="status" className="mt-3 text-sm">
+					{notice}
+				</p>
+			)}
+		</section>
+	);
+}
