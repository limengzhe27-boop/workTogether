+					data: {
+						agents: [
+							{
+								id: "codex",
+								installation: { state: "installed" },
+								effectiveReadiness: "ready",
+							},
+						],
+					},
+				})
+			: get(path, ...args),
+	);
+	let n = 0;
+	api.POST.mockImplementation(async () => ({
+		data: { session: { id: `new-${++n}` } },
+	}));
+	mount();
+	await screen.findByText("本房间的消息");
+	fireEvent.click(screen.getByRole("button", { name: "添加成员" }));
+	await waitFor(() =>
+		expect(screen.getByLabelText("Codex 人数")).toBeEnabled(),
+	);
+	fireEvent.change(screen.getByLabelText("Codex 人数"), {
+		target: { value: "2" },
+	});
+	fireEvent.click(screen.getByRole("button", { name: "添加 2 位成员" }));
+	await waitFor(() => expect(api.PUT).toHaveBeenCalled());
+	expect(room.members).toEqual(["a", "b", "new-1", "new-2"]);
+	expect(api.POST.mock.calls.every((c) => c[0] === "/api/v1/sessions")).toBe(
+		true,
+	);
+	expect(api.POST).toHaveBeenCalledTimes(2);
+	await screen.findByText(/成员已加入房间/);
+});
