diff --git a/frontend/src/renderer/components/PeerAccessControl.tsx b/frontend/src/renderer/components/PeerAccessControl.tsx
new file mode 100644
index 0000000..9593d4b
--- /dev/null
+++ b/frontend/src/renderer/components/PeerAccessControl.tsx
@@ -0,0 +1,237 @@
+import { useState } from "react";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { ShieldCheck, Hand, ShieldAlert, Check } from "lucide-react";
+import { apiClient } from "../lib/api-client";
+import type { WorkspaceSession } from "../types/workspace";
+import type { components } from "../../api/schema";
+import { Popover, PopoverTrigger, PopoverContent } from "./ui/popover";
+import { Button } from "./ui/button";
+type Mode = NonNullable<
+	components["schemas"]["ConversationTurnSettingsPayload"]["approvalMode"]
+>;
+export function PeerAccessControl({
+	sessions,
+	disabled,
+	onBusyChange,
+}: {
+	sessions: WorkspaceSession[];
+	disabled: boolean;
+	onBusyChange: (v: boolean) => void;
+}) {
+	const cache = useQueryClient();
+	const [open, setOpen] = useState(false);
+	const [selected, setSelected] = useState("");
+	const [draft, setDraft] = useState<Mode | null>(null);
+	const [saving, setSaving] = useState(false);
+	const [error, setError] = useState("");
+	const session = sessions.find((s) => s.id === selected) ?? sessions[0];
+	const key = ["peer-access", session?.id];
+	const query = useQuery({
+		queryKey: key,
+		enabled: open && !!session,
+		retry: false,
+		staleTime: 0,
+		queryFn: async () => {
+			const [m, c] = await Promise.all([
+				apiClient.GET("/api/v1/agents/chat/permission-modes", {
+					params: { query: { agents: session.provider } },
+				}),
+				apiClient.GET("/api/v1/sessions/{sessionId}/conversation", {
+					params: { path: { sessionId: session.id }, query: { limit: 1 } },
+				}),
+			]);
+			if (m.error || c.error) throw new Error("无法读取此成员的原生权限");
+			return {
+				modes:
+					m.data?.agents.find((a) => a.agent === session.provider)?.modes ?? [],
+				settings: c.data?.settings ?? {},
+			};
+		},
+	});
+	const codex = session?.provider === "codex";
+	const current = query.data?.settings.approvalMode ?? "default";
+	const value = draft ?? current;
+	const choices: {
+		mode: Mode;
+		label: string;
+		description: string;
+		icon: typeof Hand;
+	}[] = codex
+		? [
+				{
+					mode: "accept-edits",
+					label: "请求批准",
+					description: "访问工作区外文件或执行需要批准的操作时询问",
+					icon: Hand,
+				},
+				{
+					mode: "auto",
+					label: "帮我批准",
+					description: "由原生客户端评估风险，需要你决定时再询问",
+					icon: ShieldCheck,
+				},
+				{
+					mode: "bypass-permissions",
+					label: "完全访问权限",
+					description: "不再询问，允许访问文件及执行命令；仍受系统权限限制",
+					icon: ShieldAlert,
+				},
+			]
+		: [
+				{
+					mode: "default",
+					label: "遵循客户端设置",
+					description: "使用这位成员原生客户端配置的审批方式",
+					icon: Hand,
+				},
+				{
+					mode: "accept-edits",
+					label: "允许文件编辑",
+					description: "文件编辑可自动执行，其他操作遵循客户端审批",
+					icon: Hand,
+				},
+				{
+					mode: "auto",
+					label: "自动审批",
+					description: "使用客户端支持的自动审批模式",
+					icon: ShieldCheck,
+				},
+				{
+					mode: "bypass-permissions",
+					label: "跳过审批",
+					description: "客户端不再请求批准；仍受系统权限限制",
+					icon: ShieldAlert,
+				},
+			];
+	async function apply() {
+		if (!session || !draft || saving || disabled || !query.data) return;
+		setSaving(true);
+		onBusyChange(true);
+		setError("");
+		try {
+			const r = await apiClient.PATCH(
+				"/api/v1/sessions/{sessionId}/conversation/settings",
+				{
+					params: { path: { sessionId: session.id } },
+					body: { ...query.data.settings, approvalMode: draft },
+				},
+			);
+			if (r.error) throw r.error;
+			await cache.invalidateQueries({ queryKey: key });
+			await cache.invalidateQueries({
+				queryKey: ["peer-agent-settings", session.id],
+			});
+			setDraft(null);
+		} catch (e) {
+			setError(
+				e && typeof e === "object" && "message" in e
+					? String(e.message)
+					: "权限未保存，请检查原生会话",
+			);
+		} finally {
+			setSaving(false);
+			onBusyChange(false);
+		}
+	}
+	return (
+		<Popover
+			open={open}
+			onOpenChange={(v) => {
+				if (!saving) {
+					setOpen(v);
+					setDraft(null);
+					setError("");
+				}
+			}}
+		>
+			<PopoverTrigger asChild>
+				<button
+					type="button"
+					disabled={disabled || !sessions.length}
+					className="inline-flex min-h-10 items-center gap-1 rounded-lg px-2 text-xs hover:bg-background focus-visible:ring-2 focus-visible:ring-ring"
+					aria-label="访问权限"
+				>
+					<ShieldCheck className="size-4" />
+					访问权限
+				</button>
+			</PopoverTrigger>
+			<PopoverContent
+				side="top"
+				align="start"
+				className="w-96 max-w-[calc(100vw-2rem)] p-3"
+			>
+				<p className="mb-3 text-sm font-medium">如何批准这位成员的操作？</p>
+				<select
+					aria-label="权限所属成员"
+					className="mb-3 w-full rounded-md border border-border bg-background p-2 text-sm"
+					disabled={saving}
+					value={session?.id ?? ""}
+					onChange={(e) => {
+						setSelected(e.target.value);
+						setDraft(null);
+						setError("");
+					}}
+				>
+					{sessions.map((s) => (
+						<option key={s.id} value={s.id}>
+							{s.title || s.id}
+						</option>
+					))}
+				</select>
+				{query.isPending && <p className="text-sm">读取原生权限…</p>}
+				<div role="radiogroup" aria-label="原生访问权限">
+					{choices
+						.filter((c) => query.data?.modes.includes(c.mode))
+						.map((c) => (
+							<button
+								key={c.mode}
+								type="button"
+								role="radio"
+								aria-checked={
+									value === c.mode ||
+									(codex &&
+										c.mode === "bypass-permissions" &&
+										value === "default")
+								}
+								disabled={saving || disabled}
+								className="flex min-h-14 w-full items-center gap-3 rounded-lg p-2 text-left hover:bg-secondary focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50"
+								onClick={() => setDraft(c.mode)}
+							>
+								<c.icon className="size-4 shrink-0" />
+								<span className="flex-1">
+									<span className="block text-sm font-medium">{c.label}</span>
+									<span className="block text-xs text-muted-foreground">
+										{c.description}
+									</span>
+								</span>
+								{(value === c.mode ||
+									(codex &&
+										c.mode === "bypass-permissions" &&
+										value === "default")) && <Check className="size-4" />}
+							</button>
+						))}
+				</div>
+				{(error || query.isError) && (
+					<p role="alert" className="my-2 text-sm text-destructive">
+						{error || "无法读取权限，未作更改。"}
+					</p>
+				)}
+				{query.data && !query.data.modes.length && (
+					<p className="text-sm text-muted-foreground">
+						此客户端未提供可切换的权限模式。
+					</p>
+				)}
+				{draft && draft !== current && (
+					<div className="mt-3 border-t border-border pt-3">
+						<p className="mb-2 text-xs text-muted-foreground">
+							只修改这位成员的后续操作，不影响其他成员。
+						</p>
+						<Button disabled={saving || disabled} onClick={() => void apply()}>
+							{saving ? "正在保存…" : "应用权限"}
+						</Button>
+					</div>
+				)}
+			</PopoverContent>
+		</Popover>
+	);
+}
diff --git a/frontend/src/renderer/components/PeerAgentSettings.tsx b/frontend/src/renderer/components/PeerAgentSettings.tsx
new file mode 100644
index 0000000..46c07f7
--- /dev/null
+++ b/frontend/src/renderer/components/PeerAgentSettings.tsx
@@ -0,0 +1,353 @@
+import { useState } from "react";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { Bot, ChevronDown } from "lucide-react";
+import { apiClient } from "../lib/api-client";
+import type { WorkspaceSession } from "../types/workspace";
+import type { components } from "../../api/schema";
+import { Button } from "./ui/button";
+import { Popover, PopoverContent, PopoverTrigger } from "./ui/popover";
+import { CodexIcon, AntigravityIcon } from "./icons";
+
+export function PeerAgentIcon({ provider }: { provider?: string }) {
+	const Icon =
+		provider === "codex"
+			? CodexIcon
+			: provider === "agy"
+				? AntigravityIcon
+				: Bot;
+	return <Icon className="size-4 shrink-0" aria-hidden="true" />;
+}
+const effortLabels: Record<string, string> = {
+	off: "关闭",
+	low: "低",
+	medium: "中",
+	high: "高",
+	xhigh: "极高",
+	max: "最高",
+	ultra: "超高",
+};
+type Settings = components["schemas"]["ConversationTurnSettingsPayload"];
+function message(e: unknown) {
+	return e && typeof e === "object" && "message" in e
+		? String(e.message)
+		: "设置未保存，请稍后再试";
+}
+
+/** Uses each native session's actual catalog, never a shared invented model list. */
+export function PeerAgentSettings({
+	session,
+	issue,
+	disabled,
+	onBusyChange,
+	onRenamed,
+	onOpenSession,
+}: {
+	session: WorkspaceSession;
+	issue: string;
+	disabled: boolean;
+	onBusyChange: (busy: boolean) => void;
+	onRenamed: (name: string) => void;
+	onOpenSession?: () => void;
+}) {
+	const cache = useQueryClient();
+	const [open, setOpen] = useState(false);
+	const [name, setName] = useState(session.title || session.id);
+	const [saving, setSaving] = useState(false);
+	const [error, setError] = useState("");
+	const key = ["peer-agent-settings", session.id];
+	const catalog = useQuery({
+		queryKey: key,
+		enabled: open && !issue,
+		retry: false,
+		staleTime: 0,
+		queryFn: async () => {
+			const [models, config] = await Promise.all([
+				apiClient.GET("/api/v1/sessions/{sessionId}/conversation/models", {
+					params: { path: { sessionId: session.id } },
+				}),
+				apiClient.GET(
+					"/api/v1/sessions/{sessionId}/conversation/config-options",
+					{ params: { path: { sessionId: session.id } } },
+				),
+			]);
+			if (models.error || config.error) throw models.error || config.error;
+			return {
+				models: models.data?.models ?? [],
+				settings: models.data?.selected ?? {},
+				options: config.data?.options ?? [],
+			};
+		},
+	});
+	async function save(action: () => Promise<void>) {
+		if (saving || disabled) return;
+		setSaving(true);
+		onBusyChange(true);
+		setError("");
+		try {
+			await action();
+			await cache.invalidateQueries({ queryKey: key });
+			await cache.invalidateQueries({ queryKey: ["peer-room-conversation"] });
+		} catch (e) {
+			setError(message(e));
+		} finally {
+			setSaving(false);
+			onBusyChange(false);
+		}
+	}
+	async function nativeOption(id: string, value: string) {
+		const r = await apiClient.PATCH(
+			"/api/v1/sessions/{sessionId}/conversation/config-options/{configId}",
+			{
+				params: { path: { sessionId: session.id, configId: id } },
+				body: { value },
+			},
+		);
+		if (r.error) throw r.error;
+	}
+	async function settings(next: Settings) {
+		const r = await apiClient.PATCH(
+			"/api/v1/sessions/{sessionId}/conversation/settings",
+			{
+				params: { path: { sessionId: session.id } },
+				body: { ...catalog.data?.settings, ...next },
+			},
+		);
+		if (r.error) throw r.error;
+	}
+	const data = catalog.data;
+	const modelOption = data?.options.find(
+		(o) => o.type === "select" && (o.category === "model" || o.id === "model"),
+	);
+	const thoughtOption = data?.options.find(
+		(o) =>
+			o.type === "select" &&
+			(o.category === "thought_level" || o.id === "reasoning_effort"),
+	);
+	const model =
+		data?.models.find((m) => m.id === data.settings.model) ??
+		data?.models.find((m) => m.default);
+	const modelName =
+		modelOption?.choices?.find((c) => c.value === modelOption.currentValue)
+			?.name || model?.displayName;
+	const blocked = saving || disabled || !!issue;
+	const selectClass =
+		"w-full rounded-md border border-border bg-background px-3 py-2 text-sm focus-visible:ring-2 focus-visible:ring-ring";
+	return (
+		<Popover
+			open={open}
+			onOpenChange={(v) => {
+				if (!saving) {
+					setOpen(v);
+					if (v) {
+						setName(session.title || session.id);
+						setError("");
+					}
+				}
+			}}
+		>
+			<PopoverTrigger asChild>
+				<button
+					type="button"
+					aria-label={`设置成员 ${session.title || session.id}`}
+					title={`${session.title || session.id} · ${issue || "就绪"}`}
+					className="inline-flex min-h-9 max-w-48 items-center gap-1.5 rounded-lg px-2 text-sm hover:bg-secondary focus-visible:ring-2 focus-visible:ring-ring"
+					disabled={disabled}
+				>
+					<PeerAgentIcon provider={session.provider} />
+					<span className="truncate">{session.title || session.id}</span>
+					{issue && (
+						<span
+							className="size-1.5 rounded-full bg-destructive"
+							aria-label="暂不可用"
+						/>
+					)}
+					<ChevronDown className="size-3 text-muted-foreground" />
+				</button>
+			</PopoverTrigger>
+			<PopoverContent
+				side="top"
+				align="start"
+				className="w-80 max-w-[calc(100vw-2rem)] space-y-4 p-4"
+			>
+				<div className="flex items-center gap-2">
+					<PeerAgentIcon provider={session.provider} />
+					<strong className="text-sm">{session.title || session.id}</strong>
+					<span className="ml-auto text-xs text-muted-foreground">
+						{session.provider}
+					</span>
+				</div>
+				<label className="block space-y-1 text-xs">
+					成员名称
+					<input
+						aria-label="成员名称"
+						className={selectClass}
+						maxLength={100}
+						value={name}
+						disabled={saving || disabled}
+						onChange={(e) => setName(e.target.value)}
+					/>
+				</label>
+				<Button
+					size="sm"
+					variant="secondary"
+					disabled={
+						saving ||
+						disabled ||
+						!name.trim() ||
+						name.trim() === (session.title || session.id)
+					}
+					onClick={() =>
+						void save(async () => {
+							const r = await apiClient.PATCH("/api/v1/sessions/{sessionId}", {
+								params: { path: { sessionId: session.id } },
+								body: { displayName: name.trim() },
+							});
+							if (r.error) throw r.error;
+							onRenamed(name.trim());
+							await cache.invalidateQueries({ queryKey: ["workspaces"] });
+						})
+					}
+				>
+					保存名称
+				</Button>
+				{issue ? (
+					<p role="status" className="text-sm text-muted-foreground">
+						{issue}。未发送不代表模型回复失败。
+					</p>
+				) : (
+					<>
+						{catalog.isPending && (
+							<p className="text-xs text-muted-foreground">读取客户端选项…</p>
+						)}
+						{modelOption ? (
+							<label className="block space-y-1 text-xs">
+								模型
+								<select
+									aria-label="模型"
+									className={selectClass}
+									disabled={blocked}
+									value={modelOption.currentValue}
+									onChange={(e) =>
+										void save(() =>
+											nativeOption(modelOption.id, e.target.value),
+										)
+									}
+								>
+									{modelOption.choices?.map((c) => (
+										<option key={c.value} value={c.value}>
+											{c.name}
+											{c.groupName ? ` · ${c.groupName}` : ""}
+										</option>
+									))}
+								</select>
+							</label>
+						) : !!data?.models.length ? (
+							<label className="block space-y-1 text-xs">
+								模型
+								<select
+									aria-label="模型"
+									className={selectClass}
+									disabled={blocked}
+									value={model?.id ?? ""}
+									onChange={(e) => {
+										const m = data.models.find((x) => x.id === e.target.value);
+										void save(() =>
+											settings({
+												model: e.target.value,
+												reasoningEffort: m?.defaultEffort || "",
+											}),
+										);
+									}}
+								>
+									{data.models.map((m) => (
+										<option key={m.id} value={m.id}>
+											{m.displayName}
+										</option>
+									))}
+								</select>
+							</label>
+						) : (
+							data && (
+								<p className="text-xs text-muted-foreground">
+									跟随客户端模型；此会话未提供可切换列表。
+								</p>
+							)
+						)}
+						{thoughtOption ? (
+							<label className="block space-y-1 text-xs">
+								推理强度
+								<select
+									aria-label="推理强度"
+									className={selectClass}
+									disabled={blocked}
+									value={thoughtOption.currentValue}
+									onChange={(e) =>
+										void save(() =>
+											nativeOption(thoughtOption.id, e.target.value),
+										)
+									}
+								>
+									{thoughtOption.choices?.map((c) => (
+										<option key={c.value} value={c.value}>
+											{effortLabels[c.value] || c.name}
+										</option>
+									))}
+								</select>
+							</label>
+						) : (
+							!!model?.efforts?.length && (
+								<label className="block space-y-1 text-xs">
+									推理强度
+									<select
+										aria-label="推理强度"
+										className={selectClass}
+										disabled={blocked}
+										value={
+											data?.settings.reasoningEffort ||
+											model.defaultEffort ||
+											""
+										}
+										onChange={(e) =>
+											void save(() =>
+												settings({
+													model: model.id,
+													reasoningEffort: e.target.value,
+												}),
+											)
+										}
+									>
+										{model.efforts.map((v) => (
+											<option key={v} value={v}>
+												{effortLabels[v] || v}
+											</option>
+										))}
+									</select>
+								</label>
+							)
+						)}
+						{modelName && (
+							<p className="text-xs text-muted-foreground">
+								设置用于这位成员的后续消息。
+							</p>
+						)}
+					</>
+				)}
+				{(error || catalog.error) && (
+					<p role="alert" className="text-sm text-destructive">
+						{error || message(catalog.error)}
+					</p>
+				)}
+				{saving && (
+					<p role="status" className="text-xs">
+						正在保存…
+					</p>
+				)}
+				{onOpenSession && (
+					<Button variant="quiet" size="sm" onClick={onOpenSession}>
+						打开原生会话
+					</Button>
+				)}
+			</PopoverContent>
+		</Popover>
+	);
+}
