+import type { components } from "../../api/schema";
+import { ChatMarkdown } from "./chat/ChatMarkdown";
+import { PeerAgentIcon } from "./PeerAgentSettings";
+type Delivery = components["schemas"]["PeerDelivery"];
+export function peerMessageGroups(deliveries: Delivery[]) {
+	const groups: Delivery[][] = [];
+	const indexes = new Map<string, number>();
+	for (const d of deliveries) {
+		const key =
+			d.broadcastId && !d.sender
+				? JSON.stringify([d.broadcastId, d.epoch, d.message])
+				: d.id;
+		const index = indexes.get(key);
+		if (index === undefined) {
+			indexes.set(key, groups.length);
+			groups.push([d]);
+		} else groups[index].push(d);
+	}
+	return groups;
+}
+export function PeerTimeline({
+	deliveries,
+	label,
+	provider,
+	status,
+}: {
+	deliveries: Delivery[];
+	label: (id: string) => string;
+	provider: (id: string) => string | undefined;
+	status: (d: Delivery) => string;
+}) {
+	return (
+		<div className="space-y-8" aria-label="群聊消息记录">
+			{peerMessageGroups(deliveries).map((group) => {
+				const first = group[0];
+				return (
+					<div key={first.id} className="space-y-5">
+						<div
+							className={
+								first.sender
+									? "text-sm text-muted-foreground"
+									: "ml-auto max-w-[85%] rounded-2xl bg-secondary px-5 py-3"
+							}
+						>
+							<div className="mb-1 flex items-center gap-2 text-xs text-muted-foreground">
+								{first.sender && (
+									<PeerAgentIcon provider={provider(first.sender)} />
+								)}
+								<span>
+									{first.sender
+										? `${label(first.sender)} → ${label(first.target)}`
+										: "你"}
+								</span>
+							</div>
+							<ChatMarkdown text={first.message} />
+						</div>
+						{group.map((d) => (
+							<article
+								key={d.id}
+								className="py-1"
+								aria-label={`来自 ${label(d.target)} 的回复`}
+							>
+								<div className="mb-3 flex items-center gap-2 text-xs text-muted-foreground">
+									<PeerAgentIcon provider={provider(d.target)} />
+									<span className="font-medium text-foreground">
+										{label(d.target)}
+									</span>
+									<span>{status(d)}</span>
+								</div>
+								{d.detail && (
+									<p role="status" className="mb-3 text-sm text-destructive">
+										{d.detail}
+									</p>
+								)}
+								{d.state === "uncertain" && (
+									<details className="mb-3 text-xs text-muted-foreground">
+										<summary className="cursor-pointer">查看投递异常</summary>
+										<p>{d.detail || "旧记录未保存失败原因；不会自动重发。"}</p>
+										<p>投递编号：{d.id}</p>
+									</details>
+								)}
+								<div className="space-y-4 text-base leading-7">
+									{(d.replies ?? []).map((r) => (
+										<ChatMarkdown
+											key={r.id}
+											text={r.text}
+											streaming={r.streaming}
+										/>
+									))}
+								</div>
+								{d.repliesTruncated && (
+									<p className="text-xs text-muted-foreground">
+										更多内容请查看原生会话。
+									</p>
+								)}
+							</article>
+						))}
+					</div>
+				);
+			})}
+		</div>
+	);
+}
