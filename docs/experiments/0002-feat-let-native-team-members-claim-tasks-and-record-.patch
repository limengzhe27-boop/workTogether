index 0000000..f9328c5
--- /dev/null
+++ b/backend/internal/cli/mcp_tasks.go
@@ -0,0 +1,56 @@
+package cli
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/aoagents/agent-orchestrator/backend/internal/domain"
+	"net/url"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+)
+
+var peerTasksTool = map[string]any{"name": "peer_tasks", "description": "Read team tasks and revisions. Choose work suited to your abilities; claim before editing. Submitted work still needs independent review; acceptance does not merge code.", "inputSchema": map[string]any{"type": "object", "properties": map[string]any{}, "additionalProperties": false}}
+var peerTaskTool = map[string]any{"name": "peer_task", "description": "Claim an open task, submit your work with evidence and candidate commit, or independently accept/reject a submission. Use the last observed revision. Read again on conflict; never steal a claim. Only edit after claim succeeds.", "inputSchema": map[string]any{"type": "object", "additionalProperties": false, "required": []string{"id", "revision", "action"}, "properties": map[string]any{"id": map[string]any{"type": "string"}, "revision": map[string]any{"type": "integer"}, "action": map[string]any{"type": "string", "enum": []string{"claim", "submit", "accept", "reject"}}, "evidence": map[string]any{"type": "string"}, "commit": map[string]any{"type": "string"}}}}
+
+func (c *commandContext) callPeerTasks(ctx context.Context, raw json.RawMessage, act bool) map[string]any {
+	room, actor := os.Getenv("AO_PEER_ROOM"), os.Getenv("AO_SESSION_ID")
+	epoch, err := strconv.ParseInt(os.Getenv("AO_PEER_EPOCH"), 10, 64)
+	if os.Getenv("AO_PEER_PROJECT") == "" || room == "" || actor == "" || epoch < 1 || err != nil {
+		return mcpToolError(fmt.Errorf("room binding required"))
+	}
+	path := "peer-rooms/" + url.PathEscape(room)
+	var r domain.PeerRoom
+	if err = c.getJSON(ctx, path, &r); err != nil {
+		return mcpToolError(err)
+	}
+	if r.Paused || r.Epoch != epoch || !slices.Contains(r.Members, actor) {
+		return mcpToolError(fmt.Errorf("room paused, revoked or non-member"))
+	}
+	var result any
+	if act {
+		var input struct {
+			ID       string `json:"id"`
+			Revision int64  `json:"revision"`
+			Action   string `json:"action"`
+			Evidence string `json:"evidence"`
+			Commit   string `json:"commit"`
+		}
+		d := json.NewDecoder(strings.NewReader(string(raw)))
+		d.DisallowUnknownFields()
+		if err = d.Decode(&input); err != nil {
+			return mcpToolError(err)
+		}
+		a := domain.PeerTaskAction{ID: input.ID, Actor: actor, Epoch: epoch, Revision: input.Revision, Action: input.Action, Evidence: input.Evidence, Commit: input.Commit}
+		err = c.postJSON(ctx, path+"/tasks", a, &result)
+	} else {
+		err = c.getJSON(ctx, path+"/tasks", &result)
+	}
+	if err != nil {
+		return mcpToolError(err)
+	}
+	data, _ := json.Marshal(result)
+	return map[string]any{"content": []any{mcpText(string(data))}}
+}
