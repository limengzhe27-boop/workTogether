+// Preserve the original user message in delivery history; add routing context only at execution.
+func peerBroadcastPrompt(room, self string, targets []string, in PeerBroadcastRequest) string {
+	context, _ := json.Marshal(struct {
+		Room       string   `json:"room"`
+		Self       string   `json:"self"`
+		Recipients []string `json:"recipients"`
+	}{room, self, targets})
+	tools := "同伴工具未在此次发送中授权；不要声称已经联系同伴。若已有授权，可通过 peer_tasks 查询。"
+	if in.ConnectPeers {
+		tools = "本房间同伴工具已获用户授权。用 peer_tasks 查看任务和成员；peer_send 向 recipients 中其他会话发送必要的问题、交接或结论；peer_task 提议、认领、提交与交叉验收任务。"
+	}
+	return fmt.Sprintf("[项目群聊上下文]\n%s\n你是 self 指定的独立原生会话，其他 recipients 同时收到本次用户消息。%s\n先按任务需要简短讨论并自主分工，再工作。不要互相重复确认，不要循环致谢，不要自动重发失败消息。没有实质问题时直接汇报。尊重项目写入权限和任务认领边界；工具返回成功只代表投递，不代表同伴完成。不要联系本次未选中的成员。\n[用户消息]\n%s", context, tools, in.Message)
+}
