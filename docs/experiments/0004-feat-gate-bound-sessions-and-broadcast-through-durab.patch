new file mode 100644
index 0000000..7244f9d
--- /dev/null
+++ b/backend/internal/peerpolicy/guard.go
@@ -0,0 +1,41 @@
+// Package peerpolicy prevents legacy delivery from bypassing room admission.
+package peerpolicy
+
+import (
+	"context"
+
+	"github.com/aoagents/agent-orchestrator/backend/internal/httpd/apierr"
+)
+
+type bindingStore interface {
+	PeerSessionBound(context.Context, string) (bool, error)
+}
+type admissionKey struct{}
+type admission struct{ sender, target string }
+
+// Admitted is used only after a durable room budget reservation. Never decode it from HTTP.
+func Admitted(ctx context.Context, sender, target string) context.Context {
+	return context.WithValue(ctx, admissionKey{}, admission{sender, target})
+}
+func Check(ctx context.Context, store any, sender, target string) error {
+	if a, ok := ctx.Value(admissionKey{}).(admission); ok && a.sender == sender && a.target == target {
+		return nil
+	}
+	s, ok := store.(bindingStore)
+	if !ok {
+		return nil
+	} // legacy test stores; production SQLite implements this port
+	for _, id := range []string{sender, target} {
+		if id == "" {
+			continue
+		}
+		bound, err := s.PeerSessionBound(ctx, id)
+		if err != nil {
+			return apierr.Unavailable("PEER_POLICY_UNAVAILABLE", "Cannot verify room binding")
+		}
+		if bound {
+			return apierr.Conflict("PEER_ROOM_REQUIRED", "This session requires room admission; use the bound peer-room channel", nil)
+		}
+	}
+	return nil
+}
diff --git a/backend/internal/peerpolicy/guard_test.go b/backend/internal/peerpolicy/guard_test.go
new file mode 100644
index 0000000..78a2481
--- /dev/null
+++ b/backend/internal/peerpolicy/guard_test.go
@@ -0,0 +1,35 @@
+package peerpolicy
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+type fake struct{ err error }
+
+func (f fake) PeerSessionBound(_ context.Context, id string) (bool, error) {
+	return id == "bound", f.err
+}
+func TestAdmissionScope(t *testing.T) {
+	ctx := context.Background()
+	s := fake{}
+	for _, pair := range [][2]string{{"bound", "outside"}, {"outside", "bound"}, {"", "bound"}} {
+		if Check(ctx, s, pair[0], pair[1]) == nil {
+			t.Fatal("legacy bypass", pair)
+		}
+	}
+	if Check(ctx, s, "a", "b") != nil {
+		t.Fatal("unrelated session blocked")
+	}
+	admitted := Admitted(ctx, "bound", "outside")
+	if Check(admitted, s, "bound", "outside") != nil {
+		t.Fatal("reserved delivery blocked")
+	}
+	if Check(admitted, s, "bound", "another") == nil {
+		t.Fatal("admission escaped target")
+	}
+	if Check(ctx, fake{errors.New("db unavailable")}, "a", "b") == nil {
+		t.Fatal("lookup failure opened access")
+	}
+}
