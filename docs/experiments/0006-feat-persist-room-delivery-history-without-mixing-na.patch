 	return n > 0, err
 }
+
+// A room admits at most 100 deliveries over its lifetime; history is bounded by admission.
+func (s *Store) ListPeerDeliveries(ctx context.Context, room string) ([]domain.PeerDelivery, error) {
+	if _, err := s.GetPeerRoom(ctx, room); err != nil {
+		return nil, err
+	}
+	rows, err := s.readDB.QueryContext(ctx, "SELECT id,sender,target,message,epoch,state,created_at FROM peer_deliveries WHERE room_id=? ORDER BY created_at,id", room)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out := []domain.PeerDelivery{}
+	for rows.Next() {
+		var d domain.PeerDelivery
+		if err := rows.Scan(&d.ID, &d.Sender, &d.Target, &d.Message, &d.Epoch, &d.State, &d.CreatedAt); err != nil {
+			return nil, err
+		}
+		out = append(out, d)
+	}
+	return out, rows.Err()
+}
