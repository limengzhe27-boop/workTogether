@@ -0,0 +1,148 @@
+package store
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"github.com/aoagents/agent-orchestrator/backend/internal/domain"
+	"slices"
+	"strings"
+)
+
+func readPeerRoom(ctx context.Context, q interface {
+	QueryRowContext(context.Context, string, ...any) *sql.Row
+}, id string) (domain.PeerRoom, error) {
+	var r domain.PeerRoom
+	var members string
+	err := q.QueryRowContext(ctx, "SELECT id,project_id,members,epoch,budget,used,paused FROM peer_rooms WHERE id=?", id).Scan(&r.ID, &r.ProjectID, &members, &r.Epoch, &r.Budget, &r.Used, &r.Paused)
+	if err == nil {
+		err = json.Unmarshal([]byte(members), &r.Members)
+	}
+	return r, err
+}
+func (s *Store) GetPeerRoom(ctx context.Context, id string) (domain.PeerRoom, error) {
+	return readPeerRoom(ctx, s.readDB, id)
+}
+func peerMember(ctx context.Context, tx *sql.Tx, id, project string) error {
+	var actual string
+	var terminated bool
+	if err := tx.QueryRowContext(ctx, "SELECT project_id,is_terminated FROM sessions WHERE id=?", id).Scan(&actual, &terminated); err != nil {
+		return err
+	}
+	if actual != project || terminated {
+		return fmt.Errorf("member is outside project or terminated")
+	}
+	return nil
+}
+
+// Updates revoke old epochs and never reset usage.
+func (s *Store) ConfigurePeerRoom(ctx context.Context, r domain.PeerRoom) (domain.PeerRoom, error) {
+	if r.ID == "" || len(r.ID) > 100 || r.ProjectID == "" || r.Budget < 1 || r.Budget > 100 || (!r.Paused && len(r.Members) < 2) || len(r.Members) > 16 {
+		return r, fmt.Errorf("invalid room configuration")
+	}
+	if err := s.writeMu.LockContext(ctx); err != nil {
+		return r, err
+	}
+	defer s.writeMu.Unlock()
+	tx, err := s.writeDB.BeginTx(ctx, nil)
+	if err != nil {
+		return r, err
+	}
+	defer tx.Rollback()
+	seen := map[string]bool{}
+	for _, id := range r.Members {
+		if id == "" || seen[id] {
+			return r, fmt.Errorf("duplicate or empty member")
+		}
+		seen[id] = true
+		if err = peerMember(ctx, tx, id, r.ProjectID); err != nil && !r.Paused {
+			return r, err
+		}
+	}
+	old, err := readPeerRoom(ctx, tx, r.ID)
+	if err != nil && err != sql.ErrNoRows {
+		return r, err
+	}
+	if err == sql.ErrNoRows {
+		if r.Epoch != 0 {
+			return r, fmt.Errorf("stale room epoch")
+		}
+		r.Used = 0
+	} else {
+		if old.Epoch != r.Epoch || old.ProjectID != r.ProjectID {
+			return r, fmt.Errorf("stale epoch or changed project")
+		}
+		r.Used = old.Used
+	}
+	r.Epoch++
+	members, _ := json.Marshal(r.Members)
+	_, err = tx.ExecContext(ctx, "INSERT INTO peer_rooms(id,project_id,members,epoch,budget,used,paused) VALUES(?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET members=excluded.members,epoch=excluded.epoch,budget=excluded.budget,paused=excluded.paused", r.ID, r.ProjectID, string(members), r.Epoch, r.Budget, r.Used, r.Paused)
+	if err != nil {
+		return r, err
+	}
+	return r, tx.Commit()
+}
+
+// Reservation precedes external delivery; crashes never automatically replay.
+func (s *Store) ReservePeerMessage(ctx context.Context, room string, m domain.PeerMessage) (bool, error) {
+	if m.ID == "" || len(m.ID) > 100 || m.Sender == m.Target || strings.TrimSpace(m.Message) == "" || len(m.Message) > 2000 {
+		return false, fmt.Errorf("invalid peer message")
+	}
+	if err := s.writeMu.LockContext(ctx); err != nil {
+		return false, err
+	}
+	defer s.writeMu.Unlock()
+	tx, err := s.writeDB.BeginTx(ctx, nil)
+	if err != nil {
+		return false, err
+	}
+	defer tx.Rollback()
+	r, err := readPeerRoom(ctx, tx, room)
+	if err != nil {
+		return false, err
+	}
+	if r.Paused || m.Epoch != r.Epoch || !slices.Contains(r.Members, m.Sender) || !slices.Contains(r.Members, m.Target) {
+		return false, fmt.Errorf("room paused, stale epoch or non-member")
+	}
+	for _, id := range []string{m.Sender, m.Target} {
+		if err = peerMember(ctx, tx, id, r.ProjectID); err != nil {
+			return false, err
+		}
+	}
+	raw, _ := json.Marshal(m)
+	digest := fmt.Sprintf("%x", sha256.Sum256(raw))
+	var prior, state string
+	err = tx.QueryRowContext(ctx, "SELECT digest,state FROM peer_deliveries WHERE room_id=? AND id=?", room, m.ID).Scan(&prior, &state)
+	if err == nil {
+		if prior != digest {
+			return false, fmt.Errorf("message id reused with different content")
+		}
+		if state != "accepted" {
+			return false, fmt.Errorf("delivery unresolved; do not replay")
+		}
+		return false, nil
+	}
+	if err != sql.ErrNoRows {
+		return false, err
+	}
+	if r.Used >= r.Budget {
+		return false, fmt.Errorf("room message budget exhausted")
+	}
+	if _, err = tx.ExecContext(ctx, "INSERT INTO peer_deliveries(room_id,id,digest,state) VALUES(?,?,?,'pending')", room, m.ID, digest); err != nil {
+		return false, err
+	}
+	if _, err = tx.ExecContext(ctx, "UPDATE peer_rooms SET used=used+1 WHERE id=?", room); err != nil {
+		return false, err
+	}
+	return true, tx.Commit()
+}
+func (s *Store) FinishPeerMessage(ctx context.Context, room, id string, accepted bool) error {
+	state := "uncertain"
+	if accepted {
+		state = "accepted"
+	}
+	_, err := s.writeDB.ExecContext(ctx, "UPDATE peer_deliveries SET state=? WHERE room_id=? AND id=? AND state='pending'", state, room, id)
+	return err
+}
