+
+const reply = (id: string, createdAt: string, text = id) => ({
+	id,
+	createdAt,
+	text,
+	streaming: true,
+	turnState: "running",
+});
+it("orders responses by first reply rather than creation order, including after reload", () => {
+	const deliveries = [
+		{ ...a, target: "GPT1", replies: [reply("g1", "2026-11-13T09:00:03Z")] },
+		{
+			...a,
+			id: "b",
+			target: "DeepSeek",
+			replies: [reply("d", "2026-11-13T09:00:01Z")],
+		},
+		{
+			...a,
+			id: "c",
+			target: "GPT2",
+			replies: [reply("g2", "2026-11-13T09:00:02Z")],
+		},
+	];
+	const props = {
+		label: (id: string) => id,
+		provider: () => "codex",
+		status: () => "正在回复",
+	};
+	const view = render(<PeerTimeline {...props} deliveries={deliveries} />);
+	const order = () =>
+		screen.getAllByRole("article").map((el) => el.getAttribute("aria-label"));
+	expect(order()).toEqual([
+		"来自 DeepSeek 的回复",
+		"来自 GPT2 的回复",
+		"来自 GPT1 的回复",
+	]);
+	// Later commentary/final messages must not move the first responder down.
+	deliveries[1].replies.push(reply("final", "2026-11-13T09:01:00Z"));
+	view.rerender(<PeerTimeline {...props} deliveries={deliveries} />);
+	expect(order()[0]).toBe("来自 DeepSeek 的回复");
+	view.unmount();
+	render(
+		<PeerTimeline
+			{...props}
+			deliveries={JSON.parse(JSON.stringify(deliveries))}
+		/>,
+	);
+	expect(order()[0]).toBe("来自 DeepSeek 的回复");
+	expect(deliveries.map((d) => d.target)).toEqual(["GPT1", "DeepSeek", "GPT2"]);
+});
+it("keeps pending, empty and failed responses behind actual replies with stable ties", () => {
+	const deliveries = [
+		{ ...a, id: "pending", replies: [] },
+		{
+			...a,
+			id: "empty",
+			replies: [reply("empty", "2026-11-13T08:00:00Z", "  ")],
+		},
+		{ ...a, id: "failed", state: "uncertain", replies: [] },
+		{ ...a, id: "fast", replies: [reply("fast", "2026-11-13T09:00:00Z")] },
+		{ ...a, id: "tie", replies: [reply("tie", "2026-11-13T09:00:00Z")] },
+		{ ...a, id: "legacy", replies: [reply("old", "invalid")] },
+	];
+	expect(orderPeerReplies(deliveries).map((d) => d.id)).toEqual([
+		"fast",
+		"tie",
+		"legacy",
+		"pending",
+		"empty",
+		"failed",
+	]);
+});
diff --git a/frontend/src/renderer/components/PeerTimeline.tsx b/frontend/src/renderer/components/PeerTimeline.tsx
index 3ff16c6..9a4b19e 100644
--- a/frontend/src/renderer/components/PeerTimeline.tsx
+++ b/frontend/src/renderer/components/PeerTimeline.tsx
@@ -23,6 +23,28 @@ export function peerMessageGroups(deliveries: Delivery[]) {
 	}
 	return groups;
 }
+// Native message creation time survives refresh and does not change with streaming updates.
+export function orderPeerReplies(group: Delivery[]) {
+	const firstReply = (d: Delivery) => {
+		const visible = (d.replies ?? []).filter((r) => r.text.trim());
+		const times = visible
+			.map((r) => Date.parse(r.createdAt))
+			.filter(Number.isFinite);
+		return {
+			replied: visible.length > 0,
+			time: times.length ? Math.min(...times) : Infinity,
+		};
+	};
+	return group
+		.map((delivery, index) => ({ delivery, index, ...firstReply(delivery) }))
+		.sort(
+			(a, b) =>
+				Number(b.replied) - Number(a.replied) ||
+				a.time - b.time ||
+				a.index - b.index,
+		)
+		.map(({ delivery }) => delivery);
+}
 export function PeerTimeline({
 	deliveries,
 	label,
