+import { useEffect, useRef, useState } from "react";
+import { useQueries, useQuery, useQueryClient } from "@tanstack/react-query";
+import type { components } from "../../api/schema";
+import { apiClient } from "../lib/api-client";
+import type { WorkspaceSession } from "../types/workspace";
+import { Button } from "./ui/button";
+import { ChatMarkdown } from "./chat/ChatMarkdown";
+
+type Room = components["schemas"]["PeerRoom"];
+type Receipt = components["schemas"]["PeerBroadcastDelivery"];
+const states: Record<string, string> = {
+	accepted: "已接收，等待回复",
+	already_accepted: "之前已接收",
+	blocked: "未发送",
+	uncertain: "结果不确定，请核查",
+};
+const controllerStates: Record<string, string> = {
+	busy: "正在工作",
+	ready: "就绪",
+	connecting: "连接中",
+	recovering: "恢复中",
+	hibernated: "已休眠",
+	stopped: "已停止",
+};
+function failure(value: unknown): Error {
+	return new Error(
+		typeof value === "object" && value !== null && "message" in value
+			? String(value.message)
+			: "操作失败，请刷新状态后检查；不要重复发送未确认的消息。",
+	);
+}
+
+/** One durable project room; native sessions remain the owners of conversation history. */
+export function PeerRoom({
+	projectId,
+	sessions,
+	onManageSessions,
+}: {
+	projectId: string;
+	sessions: WorkspaceSession[];
+	onManageSessions: () => void;
+}) {
+	const roomId = `project-${projectId}`;
+	const cache = useQueryClient();
+	const key = ["peer-room", roomId];
+	const [draftMembers, setDraftMembers] = useState<string[] | null>(null);
+	const [draftBudget, setDraftBudget] = useState<number | null>(null);
+	const [text, setText] = useState("");
+	const [busy, setBusy] = useState(false);
+	const [error, setError] = useState("");
+	const history = useRef<HTMLDivElement>(null);
+	const followLatest = useRef(true);
+	const [receipts, setReceipts] = useState<Receipt[]>([]);
+	const recoveryKey = `peer-room-pending:${roomId}`;
+	const [uncertain, setUncertain] = useState(
+		() => sessionStorage.getItem(recoveryKey) === "1",
+	);
+	function markUncertain(value: boolean) {
+		setUncertain(value);
+		if (value) sessionStorage.setItem(recoveryKey, "1");
+		else sessionStorage.removeItem(recoveryKey);
+	}
+	const room = useQuery({
+		queryKey: key,
+		retry: false,
+		refetchInterval: 3000,
+		queryFn: async () => {
+			const result = await apiClient.GET("/api/v1/peer-rooms/{roomId}", {
+				params: { path: { roomId } },
+			});
+			if (result.response.status === 404) return null;
+			if (result.error || !result.data) throw failure(result.error);
+			if (result.data.projectId !== projectId)
+				throw new Error("房间与当前项目不匹配，已停止加载。");
+			return result.data;
+		},
+	});
+	const members = room.data?.members ?? [];
+	const selected = draftMembers ?? members;
+	const eligible = sessions.filter(
+		(s) => !s.hostId && !s.isTerminated && s.mode === "chat",
+	);
+	const conversations = useQueries({
+		queries: members.map((sessionId) => ({
+			queryKey: ["peer-room-conversation", roomId, sessionId],
+			retry: false,
+			refetchInterval: 2000,
+			queryFn: async () => {
+				const result = await apiClient.GET(
+					"/api/v1/sessions/{sessionId}/conversation",
+					{ params: { path: { sessionId }, query: { limit: 100 } } },
+				);
+				if (result.error || !result.data) throw failure(result.error);
+				return result.data;
+			},
+		})),
+	});
+	const messages = conversations
+		.flatMap((q, i) =>
+			(q.data?.messages ?? []).map((message) => ({
+				...message,
+				session: members[i],
+			})),
+		)
+		.sort(
+			(a, b) =>
+				a.createdAt.localeCompare(b.createdAt) ||
+				a.session.localeCompare(b.session) ||
+				a.sequence - b.sequence,
+		);
+	useEffect(() => {
+		if (followLatest.current && history.current)
+			history.current.scrollTop = history.current.scrollHeight;
+	}, [messages.length, messages.at(-1)?.text]);
+	const label = (id: string) => {
+		const session = sessions.find((s) => s.id === id);
+		return session
+			? `${session.title || session.id} · ${session.provider} (${id})`
+			: id;
+	};
+	async function configure(paused: boolean, nextMembers = selected) {
+		setBusy(true);
+		setError("");
+		try {
+			const body: Room = {
+				id: roomId,
+				projectId,
+				epoch: room.data?.epoch ?? 0,
+				members: nextMembers,
+				paused,
+				budget: draftBudget ?? room.data?.budget ?? 24,
+				used: room.data?.used ?? 0,
+			};
+			const result = await apiClient.PUT("/api/v1/peer-rooms/{roomId}", {
+				params: { path: { roomId } },
+				body,
+			});
+			if (result.error || !result.data) throw failure(result.error);
+			cache.setQueryData(key, result.data);
+			setDraftMembers(null);
+			setDraftBudget(null);
+		} catch (e) {
+			setError(failure(e).message);
+			await cache.invalidateQueries({ queryKey: key });
+		} finally {
+			setBusy(false);
+		}
+	}
+	async function send() {
+		if (!room.data || busy || !text.trim() || uncertain) return;
+		setBusy(true);
+		setError("");
+		setReceipts([]);
+		markUncertain(true);
+		followLatest.current = true;
+		try {
+			const result = await apiClient.POST(
+				"/api/v1/peer-rooms/{roomId}/broadcast",
+				{
+					params: { path: { roomId } },
+					body: {
+						id: crypto.randomUUID(),
+						epoch: room.data.epoch,
+						message: text,
+					},
+				},
+			);
+			if (result.error || !result.data) throw failure(result.error);
+			setReceipts(result.data.deliveries);
+			// Never silently resend a partially delivered broadcast, even after editing the draft.
+			setText("");
+			markUncertain(
+				result.data.deliveries.some((r) => r.state === "uncertain"),
+			);
+		} catch (e) {
+			setError(failure(e).message);
+			markUncertain(true);
+		} finally {
+			setBusy(false);
+			await cache.invalidateQueries({ queryKey: key });
+			await cache.invalidateQueries({
+				queryKey: ["peer-room-conversation", roomId],
+			});
+		}
+	}
+	const canSend =
+		!!room.data &&
+		!room.data.paused &&
+		members.length > 0 &&
+		room.data.used < room.data.budget &&
+		!room.isError &&
+		!busy &&
+		!uncertain &&
+		!!text.trim() &&
+		new TextEncoder().encode(text).length <= 2000;
+	return (
+		<section className="flex min-h-0 flex-1 flex-col" aria-label="项目群聊">
+			<header className="flex flex-wrap items-center justify-between gap-3 border-b border-border p-4">
+				<div>
+					<h1 className="text-base font-medium">项目群聊</h1>
+					<p className="text-sm text-muted-foreground">
+						原生会话共同参与 ·{" "}
+						{room.data
+							? `${room.data.used} / ${room.data.budget} 次投递${room.data.paused ? " · 已暂停" : ""}`
+							: "选择成员后创建房间"}
+					</p>
+				</div>
+				<div className="flex gap-2">
+					<Button variant="secondary" onClick={onManageSessions}>
+						管理 / 新建会话
+					</Button>
+					{room.data && (
+						<Button
+							variant="secondary"
+							disabled={busy}
+							onClick={() => configure(!room.data!.paused, members)}
+						>
+							{room.data.paused ? "恢复房间" : "暂停房间"}
+						</Button>
+					)}
+				</div>
+			</header>
+			<details className="border-b border-border p-4" open={!room.data}>
+				<summary className="cursor-pointer text-sm">
+					房间成员（{members.length}）
+				</summary>
+				<div className="mt-3 flex flex-wrap gap-3">
+					{eligible.map((s) => (
+						<label
+							key={s.id}
+							className="flex min-h-11 items-center gap-2 text-sm"
+						>
+							<input
+								type="checkbox"
+								checked={selected.includes(s.id)}
+								disabled={busy}
+								onChange={(e) =>
+									setDraftMembers(
+										e.target.checked
+											? [...selected, s.id]
+											: selected.filter((id) => id !== s.id),
+									)
+								}
+							/>
+							{label(s.id)}
+						</label>
+					))}
+				</div>
+				{!eligible.length && (
+					<p className="my-2 text-sm">
+						还没有可加入的本机对话会话，请先新建会话。同一种智能体可以创建多个会话。
+					</p>
+				)}
+				<label className="mt-3 flex items-center gap-2 text-sm">
+					总投递上限
+					<input
+						aria-label="总投递上限"
+						type="number"
+						min={Math.max(1, room.data?.used ?? 0)}
+						max={100}
+						value={draftBudget ?? room.data?.budget ?? 24}
+						disabled={busy}
+						onChange={(e) => setDraftBudget(Number(e.target.value))}
+						className="w-20 rounded border border-border bg-secondary p-2 focus-visible:ring-2 focus-visible:ring-ring"
+					/>
+				</label>
+				<p className="my-3 text-sm text-muted-foreground">
+					加入后通过本房间发送，原单聊发送入口会受限。暂停不强杀在途工作。修改成员后，原生同伴工具需重新绑定才能继续互发消息。
+				</p>
+				<Button
+					disabled={
+						busy ||
+						room.isPending ||
+						room.isError ||
+						!selected.length ||
+						selected.length > 16 ||
+						!Number.isInteger(draftBudget ?? 24) ||
+						(draftBudget !== null &&
+							(draftBudget < Math.max(1, room.data?.used ?? 0) ||
+								draftBudget > 100))
+					}
+					onClick={() => configure(room.data?.paused ?? false)}
+				>
+					{room.data ? "保存成员" : "创建项目房间"}
+				</Button>
+			</details>
+			{(error || room.isError) && (
+				<p role="alert" className="p-4 text-destructive">
+					{error || failure(room.error).message}
+				</p>
+			)}
+			<div
+				ref={history}
+				onScroll={(e) => {
+					const el = e.currentTarget;
+					followLatest.current =
+						el.scrollHeight - el.scrollTop - el.clientHeight < 80;
+				}}
+				className="min-h-0 flex-1 overflow-auto p-4"
+				aria-label="成员对话记录"
+			>
+				<div className="mx-auto max-w-3xl space-y-6">
+					{members.length > 0 && (
+						<p className="text-xs text-muted-foreground">
+							以下汇集成员原生会话的近期记录，包含加入房间前的对话。发送给各成员的用户消息分别显示。
+						</p>
+					)}
+					{members.map((id, i) => (
+						<p key={id} className="text-sm text-muted-foreground">
+							{label(id)}：
+							{conversations[i]?.isError
+								? "记录加载失败，不能确认当前状态"
+								: (controllerStates[conversations[i]?.data?.controller ?? ""] ??
+									"加载中")}
+							{conversations[i]?.data?.hasMoreBefore
+								? " · 仅显示最近记录，完整历史请在会话中查看"
+								: ""}
+						</p>
+					))}
+					{!messages.length && (
+						<p className="py-12 text-center text-muted-foreground">
+							在这里说明目标，消息将发给房间中的每个成员。
+						</p>
+					)}
+					{messages.map((m) => (
+						<article
+							key={`${m.session}:${m.id}`}
+							className={
+								m.role === "user"
+									? "ml-auto max-w-[90%] rounded-xl bg-secondary p-4"
+									: "py-2"
+							}
+						>
+							<p className="mb-2 text-xs text-muted-foreground">
+								{m.role === "assistant"
+									? label(m.session)
+									: `${m.senderDisplayName || m.senderSessionId || "你"} → ${label(m.session)}`}{" "}
+								· {new Date(m.createdAt).toLocaleTimeString()}
+								{m.streaming ? " · 正在回复" : ""}
+							</p>
+							<ChatMarkdown text={m.text} streaming={m.streaming} />
+						</article>
+					))}
+				</div>
+			</div>
+			<footer className="border-t border-border p-4">
+				<div className="mx-auto max-w-3xl">
+					<div aria-live="polite">
+						{receipts.map((r) => (
+							<p key={r.session} className="text-sm">
+								{label(r.session)}：{states[r.state] ?? r.state}
+								{r.detail ? ` · ${r.detail}` : ""}
+							</p>
+						))}
+					</div>
+					{uncertain && (
+						<div role="alert" className="my-2 text-sm">
+							部分结果未确认。先检查成员记录，不会自动重发。
+							<Button
+								variant="secondary"
+								onClick={() => {
+									markUncertain(false);
+									setText("");
+								}}
+							>
+								已核查，撰写新消息
+							</Button>
+						</div>
+					)}
+					<form
+						onSubmit={(e) => {
+							e.preventDefault();
+							if (canSend) void send();
+						}}
+					>
+						<label className="sr-only" htmlFor="peer-message">
+							群聊消息
+						</label>
+						<textarea
+							id="peer-message"
+							className="mt-2 min-h-24 w-full resize-y rounded-xl border border-border bg-secondary p-3 text-base outline-none focus-visible:ring-2 focus-visible:ring-ring"
+							value={text}
+							onChange={(e) => setText(e.target.value)}
+							placeholder="说明你希望团队完成什么…"
+							disabled={busy || uncertain}
+						/>
+						<div className="mt-2 flex items-center justify-between gap-3">
+							<p className="text-xs text-muted-foreground">
+								每位成员计一次投递；已接收不代表工作完成。
+								{new TextEncoder().encode(text).length > 2000
+									? "消息超过 2000 字节，请缩短。"
+									: ""}
+							</p>
+							<Button type="submit" disabled={!canSend}>
+								{busy ? "处理中…" : "发送给全体成员"}
+							</Button>
+						</div>
+					</form>
+				</div>
+			</footer>
+		</section>
+	);
+}
