+	}
+	out, err := svc.BindPeerTools(r.Context(), chi.URLParam(r, "roomId"), in.Epoch)
+	if err != nil {
+		envelope.WriteAPIError(w, r, 409, "conflict", "PEER_BINDING_REJECTED", err.Error(), nil)
+		return
+	}
