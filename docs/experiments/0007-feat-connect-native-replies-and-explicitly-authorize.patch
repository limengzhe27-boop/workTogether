+
+type nativeFixture struct {
+	*fakeCommander
+	db      *sql.DB
+	store   any
+	mu      sync.Mutex
+	pending []func() error
+}
+
+func (n *nativeFixture) SendWithOptions(ctx context.Context, id domain.SessionID, text string, _ *ports.SpawnAttachment, o ports.MessageDeliveryOptions) error {
+	if err := peerpolicy.Check(ctx, n.store, o.SenderSessionID, string(id)); err != nil {
+		return err
+	}
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.pending = append(n.pending, func() error { return n.reply(ctx, id, text, o) })
+	return nil
+}
+func (n *nativeFixture) reply(ctx context.Context, id domain.SessionID, text string, o ports.MessageDeliveryOptions) error {
+	tx, err := n.db.BeginTx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	key := o.ClientMessageID
+	for _, q := range []struct {
+		sql  string
+		args []any
+	}{
+		{"INSERT INTO conversations(id,scope,project_id,session_id,current_session_id,created_at,updated_at) VALUES(?,'session','p',?,?,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)", []any{string(id), string(id), string(id)}},
+		{"INSERT INTO conversation_turns(id,conversation_id,handled_by_session_id,state,requested_at) VALUES(?,?,?,'completed',CURRENT_TIMESTAMP)", []any{key, string(id), string(id)}},
+		{"INSERT INTO conversation_messages(id,conversation_id,turn_id,sequence,role,origin,text,client_message_id,created_at,updated_at) VALUES(?,?,?,1,'user','human',?,?,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)", []any{key + ":input", string(id), key, text, key}},
+		{"INSERT INTO conversation_messages(id,conversation_id,turn_id,sequence,role,origin,text,created_at,updated_at) VALUES(?,?,?,2,'assistant','provider',?,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)", []any{key + ":reply", string(id), key, "answer from " + string(id)}},
+	} {
+		if _, err = tx.ExecContext(ctx, q.sql, q.args...); err != nil {
+			return err
+		}
+	}
+	return tx.Commit()
+}
+func TestPeerWorkflowBroadcastRepliesAndRevocation(t *testing.T) {
+	ctx := context.Background()
+	dir := t.TempDir()
+	store := sqlitetest.MustOpenAt(t, dir)
+	db, err := sql.Open("sqlite", filepath.Join(dir, "ao.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	db.SetMaxOpenConns(1)
+	if _, err = db.Exec("PRAGMA busy_timeout=5000"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec("INSERT INTO projects(id,path,display_name,registered_at) VALUES('p','/tmp/p','p',CURRENT_TIMESTAMP)"); err != nil {
+		t.Fatal(err)
+	}
+	for i, id := range []string{"a", "b"} {
+		if _, err = db.Exec("INSERT INTO sessions(id,project_id,num,kind,activity_state,activity_last_at,created_at,updated_at) VALUES(?,'p',?,'worker','idle',CURRENT_TIMESTAMP,CURRENT_TIMESTAMP,CURRENT_TIMESTAMP)", id, i+1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	fixture := &nativeFixture{fakeCommander: &fakeCommander{}, db: db, store: store}
+	svc := NewWithDeps(Deps{Store: store, Manager: fixture})
+	room, err := svc.ConfigurePeerRoom(ctx, domain.PeerRoom{ID: "r", ProjectID: "p", Members: []string{"a", "b"}, Budget: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = svc.BindPeerTools(ctx, "r", room.Epoch); err != nil {
+		t.Fatal(err)
+	}
+	input := PeerBroadcastRequest{ID: "broadcast", Epoch: room.Epoch, Message: "discuss and propose tasks"}
+	result, err := svc.BroadcastPeerRoom(ctx, "r", input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range result.Deliveries {
+		if d.State != "accepted" {
+			t.Fatal(result)
+		}
+	}
+	for _, reply := range fixture.pending {
+		if err := reply(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	history, err := svc.ListPeerDeliveries(ctx, "r")
+	if err != nil || len(history) != 2 {
+		t.Fatal(history, err)
+	}
+	for _, d := range history {
+		if len(d.Replies) != 1 || d.Replies[0].Text != "answer from "+d.Target {
+			t.Fatal(d)
+		}
+	}
+	duplicate, err := svc.BroadcastPeerRoom(ctx, "r", input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, d := range duplicate.Deliveries {
+		if d.State != "already_accepted" {
+			t.Fatal(duplicate)
+		}
+	}
+	room.Paused = true
+	room, err = svc.ConfigurePeerRoom(ctx, room)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = svc.GetPeerToolBinding(ctx, "a"); err == nil {
+		t.Fatal("paused grant still valid")
+	}
+	room.Paused = false
+	room, err = svc.ConfigurePeerRoom(ctx, room)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = svc.GetPeerToolBinding(ctx, "a"); err == nil {
+		t.Fatal("resume silently upgraded grant")
+	}
+	if _, err = svc.BindPeerTools(ctx, "r", room.Epoch); err != nil {
+		t.Fatal(err)
+	}
+	if binding, err := svc.GetPeerToolBinding(ctx, "a"); err != nil || binding.Epoch != room.Epoch {
+		t.Fatal(binding, err)
+	}
+}
