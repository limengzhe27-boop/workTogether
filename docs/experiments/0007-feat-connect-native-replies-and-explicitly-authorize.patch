+		// Match a persisted input key and native turn, never text similarity or a time window.
+		replies, err := s.readDB.QueryContext(ctx, `SELECT DISTINCT a.id,a.text,a.streaming,t.state,a.sequence
+   FROM conversation_messages u JOIN conversations c ON c.id=u.conversation_id
