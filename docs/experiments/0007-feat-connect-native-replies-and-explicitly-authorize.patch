+export function PeerTasks({
+	roomId,
+	epoch = 0,
+	paused = false,
+}: {
+	roomId: string;
+	epoch?: number;
+	paused?: boolean;
+}) {
+	const cache = useQueryClient();
+	const [goal, setGoal] = useState("");
+	const [base, setBase] = useState("");
+	const [name, setName] = useState("");
+	const [candidate, setCandidate] = useState("");
+	async function integrate() {
+		setBusy(true);
+		setError("");
+		try {
+			const r = await apiClient.POST("/api/v1/peer-rooms/{roomId}/integrate", {
+				params: { path: { roomId } },
+				body: { epoch, base, name },
+			});
+			if (r.error || !r.data)
+				throw new Error("候选集成未完成，请检查冲突或版本。不会覆盖现有分支。");
+			setCandidate(`${r.data.branch} · ${r.data.commit}`);
+		} catch (e) {
+			setError(String(e));
+		} finally {
+			setBusy(false);
+		}
+	}
+	const [busy, setBusy] = useState(false);
+	const [error, setError] = useState("");
+	const key = ["peer-tasks", roomId];
+	const query = useQuery({
+		queryKey: key,
+		refetchInterval: 3000,
+		retry: false,
+		queryFn: async () => {
+			const r = await apiClient.GET("/api/v1/peer-rooms/{roomId}/tasks", {
+				params: { path: { roomId } },
+			});
+			if (r.error || !r.data) throw new Error("任务读取失败");
+			return r.data;
+		},
+	});
+	async function add() {
+		setBusy(true);
+		setError("");
+		try {
+			const r = await apiClient.PUT("/api/v1/peer-rooms/{roomId}/tasks", {
+				params: { path: { roomId } },
+				body: {
+					id: crypto.randomUUID(),
+					goal,
+					state: "open",
+					owner: "",
+					revision: 0,
+					evidence: "",
+					commit: "",
+					reviewer: "",
+				},
+			});
+			if (r.error) throw new Error("创建失败，请刷新核查，避免重复创建。");
+			setGoal("");
+			await cache.invalidateQueries({ queryKey: key });
+		} catch (e) {
+			setError(String(e));
+		} finally {
+			setBusy(false);
+		}
+	}
+	return (
+		<details className="border-b border-border p-4">
+			<summary className="cursor-pointer text-sm">
+				团队任务（{query.data?.length ?? 0}）
+			</summary>
+			<p className="my-3 text-xs text-muted-foreground">
+				成员可通过同伴工具提出并认领任务。这里只创建待办，不冒充成员认领，也不会自动启动模型。
+			</p>
+			{(error || query.isError) && (
+				<p role="alert">{error || "任务读取失败，请稍后重试。"}</p>
+			)}
+			<ul className="space-y-3">
+				{(query.data ?? []).map((t) => (
+					<li key={t.id} className="border-b border-border pb-3">
+						<p>{t.goal}</p>
+						<p className="text-sm text-muted-foreground">
+							{labels[t.state] ?? t.state} · {t.owner || "尚未认领"}
+							{t.reviewer ? ` · 验收：${t.reviewer}` : ""}
+						</p>
+						{t.evidence && (
+							<details>
+								<summary>交付与验收证据</summary>
+								<pre className="whitespace-pre-wrap break-words text-sm">
+									{t.evidence}
+								</pre>
+								{t.commit && <code className="break-all">{t.commit}</code>}
+							</details>
+						)}
+					</li>
+				))}
+			</ul>
+			<form
+				className="mt-3 flex flex-wrap gap-2"
+				onSubmit={(e) => {
+					e.preventDefault();
+					if (goal.trim() && !busy) void add();
+				}}
+			>
+				<label className="sr-only" htmlFor="peer-goal">
+					任务目标
+				</label>
+				<input
+					id="peer-goal"
+					value={goal}
+					onChange={(e) => setGoal(e.target.value)}
+					placeholder="添加目标和验收标准，让成员自行认领"
+					className="min-w-0 flex-1 rounded border border-border bg-secondary p-2"
+				/>
+				<Button
+					type="submit"
+					disabled={
+						busy || !goal.trim() || new TextEncoder().encode(goal).length > 4000
+					}
+				>
+					添加任务
+				</Button>
+			</form>
+			<details className="mt-4">
+				<summary>生成候选版本</summary>
+				<p className="my-2 text-xs text-muted-foreground">
+					全部任务经另一成员验收后，生成独立候选分支。不会修改主分支或替代最终测试。
+				</p>
+				<label className="block text-sm">
+					基线提交（完整提交编号）
+					<input
+						className="my-1 w-full rounded border border-border bg-secondary p-2"
+						value={base}
+						onChange={(e) => setBase(e.target.value.trim())}
+					/>
+				</label>
+				<label className="block text-sm">
+					候选名称
+					<input
+						className="my-1 w-full rounded border border-border bg-secondary p-2"
+						value={name}
+						onChange={(e) => setName(e.target.value.trim())}
+					/>
+				</label>
+				<Button
+					disabled={
+						busy ||
+						paused ||
+						!epoch ||
+						!/^[a-f0-9]{40}$/i.test(base) ||
+						!name ||
+						!query.data?.length ||
+						query.data.some((t) => t.state !== "accepted")
+					}
+					onClick={integrate}
+				>
+					生成候选分支
+				</Button>
+				{candidate && (
+					<p className="mt-2 break-all" role="status">
+						已生成待测试候选：{candidate}
+					</p>
+				)}
+			</details>
+		</details>
+	);
+}
